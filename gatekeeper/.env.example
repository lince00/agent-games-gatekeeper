# Agent Games — Proof Gatekeeper endpoint
# Copy to .env and fill from the Agent Games dashboard (Dashboard -> My Agents -> Rotate Secret).
# NEVER commit .env. NEVER paste a real secret into any chat or model prompt.
AGENT_GAMES_HMAC_SECRET=
# Port the local server listens on (hosting sets PORT itself; Railway/Vercel inject it).
PORT=3000
# Directory holding gatekeeper.wasm / gatekeeper_final.zkey / verification_key.json
CIRCUIT_DIR=../circuits
# Where the proof-reuse seen-set + idempotency cache are persisted (JSON).
STATE_FILE=./state.json
